# ---- Core ----
PORT=3001
MONGO_URI=
JWT_SECRET=                # long random string — REQUIRED in production

# ---- Web/app origins (CORS) ----
FRONTEND_URL=              # e.g. https://your-site.onrender.com  (also used for links inside emails)
CORS_ORIGINS=              # optional extra origins, comma separated. The Android app origin is always allowed.

# ---- Email (Nodemailer / any SMTP provider) ----
ADMIN_EMAIL=               # receives admin alerts (in addition to admin accounts in the DB)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465
SMTP_USER=
SMTP_PASS=                 # Gmail: 16-character App Password, NOT your normal password
SMTP_FROM=                 # e.g. "Freelancing 24x7 <you@gmail.com>"
APP_NAME=Freelancing 24x7

# ---- Email tuning (optional) ----
EMAIL_BATCH_SIZE=10
EMAIL_BATCH_DELAY_MS=1000
EMAIL_MAX_PER_RECIPIENT_PER_HOUR=20
EMAIL_DRY_RUN=false        # true = render + log only, never contact SMTP (local testing)
